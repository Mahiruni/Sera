# Keep the verified existing host until custom-domain ownership and TLS work.
SITE_URL=https://sera-dusky-seven.vercel.app
# Set only AFTER verifying the custom domain in the hosting project.
SERA_CUSTOM_DOMAIN_VERIFIED=false
# off disables indexing; previews are excluded automatically.
SERA_SEO_INDEXING=on
# Enable only after native-language editorial approval of the public translation.
SERA_AM_REVIEWED=false
# Optional ownership verification metadata; never paste account credentials here.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Supabase public API settings; obtain only from the intended Sera project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Keep disabled until verification/reset delivery, RLS and launch reviews pass.
SERA_ACCOUNT_REGISTRATION=disabled

# Server-only automatic welcome delivery; enter the existing mailbox password in Vercel.
SUPABASE_SERVICE_ROLE_KEY=
SERA_SMTP_PASSWORD=
# Random server-only bearer credential for scheduled queue retries.
CRON_SECRET=
